{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "orcarouter": {
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://api.orcarouter.ai/v1",
                "apiKey": "{env:ORCAROUTER_API_KEY}"
            },
            "models": {
                "z-ai/glm-5.3-flash-free": {
                    "name": "GLM 5.3 Flash (Free)"
                },
                "orcarouter/free": {
                    "name": "OrcaRouter Auto Free"
                }
            }
        }
    }
}