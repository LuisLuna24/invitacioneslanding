---
interface Props {
  image: string;
  title: string;
  category: string;
  previewUrl?: string;
  tagColor?: string;
  themeDescription?: string;
}

const {
  image,
  title,
  category,
  previewUrl = "#contacto",
  tagColor = "gold",
  themeDescription = "Diseño interactivo con RSVP y mapas",
} = Astro.props;

// Category styling helpers
const categoryColors: Record<string, { bg: string; text: string; border: string }> = {
  "XV Años": { bg: "bg-lavender-500/15", text: "text-lavender-300", border: "border-lavender-500/30" },
  "Boda": { bg: "bg-gold-500/15", text: "text-gold-300", border: "border-gold-500/30" },
  "Bautizo": { bg: "bg-sky-500/15", text: "text-sky-300", border: "border-sky-500/30" },
  "Cumpleaños": { bg: "bg-amber-500/15", text: "text-amber-300", border: "border-amber-500/30" },
  "Baby Shower": { bg: "bg-rose-500/15", text: "text-rose-300", border: "border-rose-500/30" },
};

const badgeStyle = categoryColors[category] || {
  bg: "bg-gold-500/15",
  text: "text-gold-300",
  border: "border-gold-500/30",
};
---

<div class="group relative rounded-2xl overflow-hidden bg-night-900 border border-night-700/70 hover:border-gold-500/50 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.8),0_0_25px_rgba(201,168,118,0.2)] flex flex-col h-full portfolio-item" data-category={category}>
  
  <!-- Image Container with Lazy Loading & Hover Overlay -->
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-night-950">
    <img
      src={image}
      data-src={image}
      alt={`Vista previa de invitación digital: ${title}`}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover object-center transform transition-transform duration-700 ease-out group-hover:scale-105"
    />

    <!-- Ambient Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-night-950 via-night-950/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>

    <!-- Category Floating Tag -->
    <div class="absolute top-4 left-4 z-10">
      <span class:list={[
        "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold backdrop-blur-md border shadow-sm",
        badgeStyle.bg,
        badgeStyle.text,
        badgeStyle.border
      ]}>
        <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
        {category}
      </span>
    </div>

    <!-- Hover Reveal Action Button Overlay -->
    <div class="absolute inset-0 z-20 flex items-center justify-center bg-night-950/60 backdrop-blur-xs opacity-0 group-hover:opacity-100 transition-all duration-300">
      <a
        href={previewUrl}
        target={previewUrl.startsWith("http") ? "_blank" : "_self"}
        rel={previewUrl.startsWith("http") ? "noopener noreferrer" : ""}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-night-950 bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 shadow-[0_0_20px_rgba(201,168,118,0.4)] transform translate-y-2 group-hover:translate-y-0 transition-all duration-300 hover:scale-105 active:scale-95"
        aria-label={`Ver invitación de ${title}`}
      >
        <span>Ver invitación</span>
        <svg class="w-4 h-4 text-night-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Card Body Info -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="font-serif text-xl font-bold text-warm-white group-hover:text-gold-300 transition-colors">
        {title}
      </h3>
      <p class="mt-1.5 text-xs sm:text-sm text-muted-silver font-light">
        {themeDescription}
      </p>
    </div>

    <!-- Card Footer / Link Action -->
    <div class="mt-4 pt-4 border-t border-night-800 flex items-center justify-between">
      <span class="text-xs text-gold-400/90 font-medium flex items-center gap-1">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
        </svg>
        Diseño exclusivo
      </span>

      <a
        href={previewUrl}
        target={previewUrl.startsWith("http") ? "_blank" : "_self"}
        rel={previewUrl.startsWith("http") ? "noopener noreferrer" : ""}
        class="text-xs font-semibold text-warm-white hover:text-gold-400 flex items-center gap-1 transition-colors"
      >
        <span>Demo en vivo</span>
        <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>

</div>
