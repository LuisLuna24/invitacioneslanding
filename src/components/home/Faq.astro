---
import GlowOrb from "../common/GlowOrb.astro";

const faqs = [
  {
    question: "¿En cuánto tiempo entregan mi invitación digital?",
    answer: "Nuestro tiempo de entrega estándar es de 48 a 72 horas hábiles tras recibir tu información y el anticipo del 50%. Si tu evento está muy próximo, también contamos con servicio express para entregas prioritarias en 24 horas."
  },
  {
    question: "¿Cómo se comparte y cómo la abren mis invitados?",
    answer: "Te entregamos un enlace web único (URL segura HTTPS) optimizado. Solo tienes que compartirlo por WhatsApp. Tus invitados lo abren en un instante con un solo toque desde cualquier iPhone, Android, tablet o computadora, sin necesidad de descargar ninguna app."
  },
  {
    question: "¿Cómo funciona la confirmación de asistencia (RSVP)?",
    answer: "En la invitación incluimos botones interactivos de 'Confirmar asistencia'. Al presionarlo, se abre automáticamente el chat de WhatsApp con el número del anfitrión con un mensaje pre-llenado indicando su nombre y el número de pases asignados."
  },
  {
    question: "¿Puedo realizar cambios una vez entregado el primer borrador?",
    answer: "¡Por supuesto! Tu proyecto incluye revisiones y ajustes sin costo adicional. Verificamos juntos tipografías, fechas, música, enlaces de mapas y fotos hasta que estés 100% satisfecho antes de liquidar el 50% restante."
  },
  {
    question: "¿Cuánto tiempo estará activa la página de mi invitación?",
    answer: "Tu invitación permanece en línea y disponible las 24 horas desde el momento de su publicación hasta 30 días posteriores a la fecha del evento, para que tus invitados sigan consultando fotos o recuerdos."
  },
  {
    question: "¿Qué métodos de pago manejan?",
    answer: "Aceptamos transferencia bancaria interbancaria (SPEI). Iniciamos con 50% y el restante 50% se liquida únicamente al aprobar el diseño."
  }
];
---

<section id="faq" class="relative py-28 bg-night-950 overflow-hidden" x-data="{ activeIndex: null }">
  <GlowOrb color="lavender" size="md" className="top-10 -right-20 opacity-20" />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center mb-16 faq-header">
      <span class="inline-block text-xs uppercase tracking-widest text-gold-400 font-semibold mb-3">
        Resuelve tus dudas
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-warm-white tracking-tight">
        Preguntas <span class="text-gradient-luna font-bold italic">frecuentes</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-muted-silver font-light">
        Todo lo que necesitas saber sobre el servicio de invitaciones digitales interactivas de Lunaweb.
      </p>
    </div>

    <!-- Accordion List (Alpine.js) -->
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <div class="rounded-2xl bg-night-900/80 border border-night-700/60 overflow-hidden transition-colors hover:border-gold-500/30">
          <button
            type="button"
            @click={`activeIndex = (activeIndex === ${index} ? null : ${index})`}
            class="w-full py-5 px-6 text-left flex items-center justify-between gap-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 cursor-pointer"
            :aria-expanded={`(activeIndex === ${index}).toString()`}
          >
            <span class="font-serif text-lg sm:text-xl font-semibold text-warm-white transition-colors" :class={`activeIndex === ${index} ? 'text-gold-300' : ''`}>
              {faq.question}
            </span>

            <div class="w-8 h-8 rounded-full bg-night-800 border border-night-700 flex items-center justify-center flex-shrink-0 transition-transform duration-300" :class={`activeIndex === ${index} ? 'rotate-180 bg-gold-500/10 text-gold-400 border-gold-500/30' : 'text-muted-silver'`}>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </button>

          <div
            x-show={`activeIndex === ${index}`}
            x-cloak
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-2"
            class="px-6 pb-6 pt-1 text-muted-silver text-sm sm:text-base font-light leading-relaxed border-t border-night-800/80"
          >
            {faq.answer}
          </div>
        </div>
      ))}
    </div>

  </div> 
</section>
