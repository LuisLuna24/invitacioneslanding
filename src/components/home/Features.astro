---
import GlowOrb from "../common/GlowOrb.astro";

const features = [
  {
    title: "Confirmación RSVP a tu WhatsApp",
    description: "Tus invitados confirman su asistencia con un solo click directo a tu chat. Olvídate de perseguir confirmaciones una por una.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />`,
    color: "gold",
    tag: "Ahorra tiempo"
  },
  {
    title: "Ubicación en Google Maps y Waze",
    description: "Botón directo para abrir la ruta en el GPS del auto o celular. Tus invitados llegarán a tiempo sin perderse.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />`,
    color: "lavender",
    tag: "Navegación GPS"
  },
  {
    title: "Cuenta Regresiva en Vivo",
    description: "Genera expectativa y emoción visual con un contador exacto de días, horas y minutos hasta el momento del evento.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    color: "gold",
    tag: "Tiempo real"
  },
  {
    title: "Música de Fondo Personalizada",
    description: "Acompaña la experiencia con la melodía o canción favorita que represente el espíritu de tu gran celebración.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12 0c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />`,
    color: "lavender",
    tag: "Emotivo"
  },
  {
    title: "Galería de Fotos del Festejado",
    description: "Comparte las mejores tomas de la sesión previa, recuerdos o momentos especiales en un carrusel fotográfico nítido.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
    color: "gold",
    tag: "Fotografía HD"
  },
  {
    title: "Mesa de Regalos y Datos Bancarios",
    description: "Enlaces a tiendas (Liverpool, Amazon) o tarjetas con opción 'copiar CLABE' en un toque para máxima comodidad.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />`,
    color: "lavender",
    tag: "Práctico"
  },
  {
    title: "Código de Vestimenta (Dress Code)",
    description: "Muestra la paleta de colores sugerida, estilo (formal, etiqueta rigurosa, guayabera, etc.) y recomendaciones.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />`,
    color: "gold",
    tag: "Elegancia"
  },
  {
    title: "Pases Digitales y Boletos",
    description: "Indica el número de personas convocadas por pase (ej. 'Pase válido para 2 adultos') para un control total.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />`,
    color: "lavender",
    tag: "Control total"
  }
];
---

<section id="beneficios" class="relative py-24 bg-night-950 overflow-hidden">
  <!-- Subtle lighting -->
  <GlowOrb color="lavender" size="lg" className="top-1/3 -left-32 opacity-25" />
  <GlowOrb color="gold" size="md" className="bottom-12 -right-20 opacity-20" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 feature-header">
      <span class="inline-block text-xs uppercase tracking-widest text-gold-400 font-semibold mb-3">
        Funciones que deslumbran
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-warm-white tracking-tight">
        Todo lo que necesitas en una <span class="text-gradient-luna font-bold italic">invitación digital moderna</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-muted-silver font-light">
        Más que una imagen estática: un micrositio interactivo adaptado a tu estilo que tus invitados amarán abrir.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 features-grid">
      {features.map((feature) => (
        <div class="group relative p-6 rounded-2xl bg-night-900/70 border border-night-700/60 hover:border-gold-500/40 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_15px_30px_-10px_rgba(0,0,0,0.8),0_0_20px_rgba(201,168,118,0.15)] flex flex-col justify-between">
          
          <div>
            <!-- Top Row: Icon + Badge -->
            <div class="flex items-center justify-between mb-5">
              <div class:list={[
                "w-12 h-12 rounded-xl flex items-center justify-center transition-transform duration-300 group-hover:scale-110",
                feature.color === "gold"
                  ? "bg-gold-500/10 text-gold-400 border border-gold-500/20 group-hover:bg-gold-500/20"
                  : "bg-lavender-500/10 text-lavender-400 border border-lavender-500/20 group-hover:bg-lavender-500/20"
              ]}>
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <Fragment set:html={feature.icon} />
                </svg>
              </div>

              <span class="text-[11px] font-medium tracking-wide uppercase px-2.5 py-1 rounded-full bg-night-800 text-muted-silver border border-night-700">
                {feature.tag}
              </span>
            </div>

            <!-- Title -->
            <h3 class="font-serif text-xl font-semibold text-warm-white group-hover:text-gold-300 transition-colors">
              {feature.title}
            </h3>

            <!-- Description -->
            <p class="mt-2.5 text-sm text-muted-silver leading-relaxed font-light">
              {feature.description}
            </p>
          </div>

          <!-- Bottom subtle indicator -->
          <div class="mt-6 pt-4 border-t border-night-800/80 flex items-center gap-1.5 text-xs text-gold-400/80 group-hover:text-gold-300 font-medium">
            <span>Incluido en tu diseño</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
