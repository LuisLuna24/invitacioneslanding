---
import GlowOrb from "../common/GlowOrb.astro";

const whatsappUrl = "https://wa.me/525610683465?text=Hola,%20quiero%20cotizar%20una%20invitaci%C3%B3n%20digital";
---

<section id="inicio" class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-16 md:pt-36 md:pb-24 overflow-hidden">
  <!-- Celestial Background Ambience -->
  <GlowOrb color="gold" size="xl" className="-top-32 -left-20 animate-twinkle opacity-50" />
  <GlowOrb color="lavender" size="lg" className="top-1/4 -right-24 opacity-40" />
  <GlowOrb color="gold" size="md" className="bottom-0 left-1/3 opacity-30" />

  <!-- Subtle Star field decorative dots -->
  <div class="absolute inset-0 pointer-events-none -z-10 bg-[radial-gradient(#C9A876_0.75px,transparent_1px)] [background-size:32px_32px] opacity-15"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6 hero-content">
        
        <!-- Lunar Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-night-800/90 border border-gold-500/30 backdrop-blur-md shadow-[0_0_15px_rgba(201,168,118,0.15)] hero-badge">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gold-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-gold-500"></span>
          </span>
          <span class="text-xs uppercase tracking-wider font-semibold text-gold-300">
            Invitaciones Digitales de Alta Gama
          </span>
        </div>

        <!-- Main Headline -->
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-semibold text-warm-white tracking-tight leading-[1.1] hero-title">
          Invitaciones que <br class="hidden sm:inline" />
          <span class="text-gradient-luna font-bold italic">cuentan tu historia</span> <br />
          con elegancia y magia.
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg lg:text-xl text-muted-silver max-w-2xl mx-auto lg:mx-0 font-light leading-relaxed hero-subtitle">
          Diseñamos experiencias interactivas y exclusivas para <strong class="text-warm-white font-medium">XV años, bodas, bautizos y cumpleaños</strong>. Confirmación RSVP por WhatsApp, ubicación en Google Maps, cuenta regresiva, música y fotos en un solo enlace.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-3 hero-cta">
          <!-- Primary CTA (WhatsApp) -->
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full text-base font-semibold text-night-950 bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 hover:from-gold-300 hover:to-gold-400 shadow-[0_0_30px_rgba(201,168,118,0.35)] hover:shadow-[0_0_40px_rgba(201,168,118,0.6)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 group"
          >
            <!-- WhatsApp Vector Icon -->
            <svg class="w-5 h-5 text-night-950 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.072.044.419-.1 1.024z"/>
              <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.527 3.66 1.443 5.176L2 22l4.981-1.306C8.423 21.535 10.154 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.25c-1.637 0-3.15-.466-4.437-1.272l-.318-.2-2.964.777.791-2.89-.208-.331C3.993 14.996 3.5 13.546 3.5 12c0-4.687 3.813-8.5 8.5-8.5 4.687 0 8.5 3.813 8.5 8.5 0 4.688-3.813 8.5-8.5 8.5z"/>
            </svg>
            <span>Cotizar por WhatsApp</span>
          </a>

          <!-- Secondary CTA (Scroll to Portfolio) -->
          <a
            href="#portafolio"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-full text-base font-medium text-warm-white bg-night-800/80 hover:bg-night-700/80 border border-night-700 hover:border-gold-500/40 backdrop-blur-md shadow-lg transition-all duration-300 group"
          >
            <span>Ver portafolio</span>
            <svg class="w-4 h-4 text-gold-400 group-hover:translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>

        <!-- Trust Features Checklist -->
        <div class="pt-6 grid grid-cols-2 sm:grid-cols-3 gap-4 border-t border-night-800/80 text-xs sm:text-sm text-muted-silver hero-features">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>100% Personalizado</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Entrega en 48-72h</span>
          </div>
          <div class="flex items-center gap-2 col-span-2 sm:col-span-1">
            <svg class="w-4 h-4 text-lavender-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>50% anticipo / 50% al aprobar</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Smartphone Mockup -->
      <div class="lg:col-span-5 flex justify-center relative hero-mockup">
        
        <!-- Ambient halo behind device -->
        <div class="absolute -inset-4 bg-gradient-to-tr from-gold-500/20 via-lavender-500/20 to-transparent rounded-full blur-3xl opacity-75 -z-10"></div>

        <!-- Phone Shell Container -->
        <div class="relative w-[280px] sm:w-[320px] rounded-[42px] p-3.5 bg-gradient-to-b from-night-700 via-night-800 to-night-900 border-2 border-night-600/80 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9),0_0_35px_rgba(201,168,118,0.2)] animate-float">
          
          <!-- Speaker Notch & Dynamic Island -->
          <div class="absolute top-6 left-1/2 -translate-x-1/2 w-24 h-4 bg-night-950 rounded-full z-30 flex items-center justify-center">
            <div class="w-3 h-3 rounded-full bg-night-800/80 mr-3"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-blue-900/60"></div>
          </div>

          <!-- Screen Content (Card Invitation Demo) -->
          <div class="relative w-full aspect-[9/19] rounded-[32px] overflow-hidden bg-gradient-to-b from-[#0B0F19] via-[#141A2A] to-[#0E1322] border border-gold-500/25 flex flex-col justify-between p-5 text-center shadow-inner">
            
            <!-- Invitation Header Mockup -->
            <div class="pt-8 space-y-2">
              <div class="inline-flex items-center justify-center gap-1.5 text-[11px] uppercase tracking-widest text-gold-400 font-medium">
                <svg class="w-3 h-3 text-gold-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
                </svg>
                <span>Nuestra Boda</span>
                <svg class="w-3 h-3 text-gold-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
                </svg>
              </div>

              <h2 class="font-serif text-2xl font-bold text-warm-white leading-tight">
                Sofía & Mateo
              </h2>

              <p class="text-[11px] text-muted-silver italic font-serif">
                "Bajo la misma luna que fue testigo de nuestro amor"
              </p>
            </div>

            <!-- Countdown Widget Mockup -->
            <div class="bg-night-900/80 border border-gold-500/30 rounded-2xl p-3 my-2 backdrop-blur-sm">
              <div class="text-[9px] uppercase tracking-widest text-gold-400 mb-1.5 font-semibold">Faltan solo</div>
              <div class="grid grid-cols-4 gap-1.5 text-center">
                <div class="bg-night-950/80 rounded-lg p-1 border border-white/5">
                  <span class="block text-sm font-bold text-warm-white">24</span>
                  <span class="text-[8px] text-muted-silver">Días</span>
                </div>
                <div class="bg-night-950/80 rounded-lg p-1 border border-white/5">
                  <span class="block text-sm font-bold text-warm-white">08</span>
                  <span class="text-[8px] text-muted-silver">Horas</span>
                </div>
                <div class="bg-night-950/80 rounded-lg p-1 border border-white/5">
                  <span class="block text-sm font-bold text-warm-white">45</span>
                  <span class="text-[8px] text-muted-silver">Min</span>
                </div>
                <div class="bg-night-950/80 rounded-lg p-1 border border-white/5">
                  <span class="block text-sm font-bold text-gold-400">12</span>
                  <span class="text-[8px] text-muted-silver">Seg</span>
                </div>
              </div>
            </div>

            <!-- Interactive Features Pills Inside Screen -->
            <div class="space-y-1.5 text-left text-[11px]">
              <div class="flex items-center gap-2 p-2 rounded-xl bg-night-800/80 border border-white/5 text-warm-white">
                <div class="w-6 h-6 rounded-lg bg-gold-500/20 text-gold-400 flex items-center justify-center flex-shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div class="truncate">
                  <span class="font-medium text-warm-white block text-[10px]">Hacienda Los Laureles</span>
                  <span class="text-[9px] text-muted-silver">Ver ubicación en Google Maps</span>
                </div>
              </div>

              <!-- Button RSVP Mockup inside Screen -->
              <div class="w-full py-2.5 rounded-xl bg-gradient-to-r from-gold-500 to-gold-600 text-night-950 font-bold text-[11px] text-center shadow-md shadow-gold-500/20 flex items-center justify-center gap-1.5 cursor-pointer">
                <svg class="w-3.5 h-3.5 text-night-950" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.072.044.419-.1 1.024z"/>
                </svg>
                <span>Confirmar Asistencia (RSVP)</span>
              </div>
            </div>

          </div>

          <!-- Floating Badge 1: RSVP Confirmado -->
          <div class="absolute -top-3 -right-6 sm:-right-8 bg-night-900/95 border border-gold-500/40 rounded-2xl py-2 px-3 shadow-xl backdrop-blur-md flex items-center gap-2">
            <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div class="text-left">
              <span class="block text-[11px] font-semibold text-warm-white">RSVP al Instante</span>
              <span class="block text-[9px] text-muted-silver">Directo a tu WhatsApp</span>
            </div>
          </div>

          <!-- Floating Badge 2: Sin descargas -->
          <div class="absolute -bottom-4 -left-6 sm:-left-8 bg-night-900/95 border border-lavender-500/40 rounded-2xl py-2 px-3 shadow-xl backdrop-blur-md flex items-center gap-2">
            <div class="w-6 h-6 rounded-full bg-lavender-500/20 text-lavender-300 flex items-center justify-center">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="text-left">
              <span class="block text-[11px] font-semibold text-warm-white">Abre en 1 Click</span>
              <span class="block text-[9px] text-muted-silver">Cero apps que instalar</span>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
