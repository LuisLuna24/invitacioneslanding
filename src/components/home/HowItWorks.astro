---
import GlowOrb from "../common/GlowOrb.astro";

const steps = [
  {
    stepNumber: "01",
    title: "Cotiza y cuéntanos tu evento",
    description: "Escríbenos por WhatsApp con los detalles de tu fecha, tipo de evento y la temática o colores que imaginas. Iniciamos tu proyecto con el 50% de anticipo.",
    highlight: "50% Anticipo inicial",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />`
  },
  {
    stepNumber: "02",
    title: "Diseñamos tu borrador interactivo",
    description: "En 48 a 72 horas hábiles creamos tu invitación personalizada con música, ubicación GPS, cuenta regresiva y fotos. Te enviamos un demo privado para tu revisión.",
    highlight: "Revisiones y ajustes incluidos",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />`
  },
  {
    stepNumber: "03",
    title: "Aprueba, liquida y comparte tu link",
    description: "Cuando el diseño esté 100% a tu gusto, cubres el 50% restante. Recibes tu enlace único y optimizado para enviar a todos tus invitados por WhatsApp.",
    highlight: "50% al aprobar a tu entera satisfacción",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />`
  }
];

const whatsappUrl = "https://wa.me/525610683465?text=Hola,%20quiero%20conocer%20m%C3%A1s%20sobre%20el%20proceso%20de%20dise%C3%B1o%20y%20cotizar%20mi%20invitaci%C3%B3n";
---

<section id="como-funciona" class="relative py-28 bg-night-950/60 overflow-hidden border-t border-b border-night-800/80">
  <GlowOrb color="gold" size="xl" className="top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-15" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-20 how-it-works-header">
      <span class="inline-block text-xs uppercase tracking-widest text-gold-400 font-semibold mb-3">
        Proceso Simple y Transparente
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-warm-white tracking-tight">
        ¿Cómo creamos tu invitación en <span class="text-gradient-luna font-bold italic">3 simples pasos</span>?
      </h2>
      <p class="mt-4 text-base sm:text-lg text-muted-silver font-light">
        Sin complicaciones técnicas. Nosotros nos encargamos de todo el código, diseño y montaje para que tú solo disfrutes.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative steps-grid">
      
      <!-- Connecting line for desktop -->
      <div class="hidden md:block absolute top-1/2 left-[15%] right-[15%] h-0.5 bg-gradient-to-r from-gold-500/20 via-lavender-500/30 to-gold-500/20 -translate-y-12 -z-10" aria-hidden="true"></div>

      {steps.map((item, idx) => (
        <div class="relative p-8 rounded-3xl bg-night-900/80 border border-night-700/60 hover:border-gold-500/40 backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.8),0_0_20px_rgba(201,168,118,0.15)] flex flex-col justify-between group">
          
          <div>
            <!-- Step Number & Icon Header -->
            <div class="flex items-center justify-between mb-6">
              <span class="font-serif text-4xl sm:text-5xl font-bold text-night-700 group-hover:text-gold-500/50 transition-colors">
                {item.stepNumber}
              </span>

              <div class="w-12 h-12 rounded-2xl bg-gold-500/10 text-gold-400 border border-gold-500/20 flex items-center justify-center group-hover:bg-gold-500/20 group-hover:scale-110 transition-all duration-300">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <Fragment set:html={item.icon} />
                </svg>
              </div>
            </div>

            <!-- Title -->
            <h3 class="font-serif text-2xl font-bold text-warm-white group-hover:text-gold-300 transition-colors mb-3">
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-sm sm:text-base text-muted-silver font-light leading-relaxed mb-6">
              {item.description}
            </p>
          </div>

          <!-- Highlight Footer Pill -->
          <div class="pt-4 border-t border-night-800/80">
            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-gold-300 bg-gold-500/10 border border-gold-500/20 px-3 py-1.5 rounded-full">
              <svg class="w-3.5 h-3.5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              {item.highlight}
            </span>
          </div>

        </div>
      ))}
    </div>

    <!-- Assurance Trust Card (50% / 50% Scheme) -->
    <div class="mt-16 rounded-3xl p-8 sm:p-10 bg-gradient-to-r from-night-900 via-[#161D2F] to-night-900 border border-gold-500/30 shadow-[0_0_30px_rgba(201,168,118,0.1)] flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center md:text-left">
        <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gold-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Garantía de Satisfacción Lunaweb
        </div>
        <h4 class="font-serif text-2xl sm:text-3xl font-bold text-warm-white">
          Esquema de Pago Protegido: 50% anticipo y 50% al aprobar
        </h4>
        <p class="text-sm text-muted-silver max-w-2xl font-light">
          Trabajamos contigo hasta que cada detalle sea exactamente como lo soñaste. No pagas el resto hasta que veas tu invitación terminada y la apruebes.
        </p>
      </div>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-8 py-4 rounded-full text-sm font-semibold text-night-950 bg-gradient-to-r from-gold-400 to-gold-500 hover:from-gold-300 hover:to-gold-400 shadow-[0_0_20px_rgba(201,168,118,0.3)] transition-all hover:scale-105 flex-shrink-0"
      >
        <span>Empezar mi invitación</span>
        <svg class="w-4 h-4 text-night-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</section>
