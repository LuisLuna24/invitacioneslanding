---
interface Props {
  isSubpage?: boolean;
}

const { isSubpage = false } = Astro.props;

const currentYear = new Date().getFullYear();

const navLinks = [
  { name: "Inicio", href: isSubpage ? "/#inicio" : "#inicio" },
  { name: "Catálogo Completo", href: "/catalogo" },
  { name: "Beneficios", href: isSubpage ? "/#beneficios" : "#beneficios" },
  { name: "Cómo funciona", href: isSubpage ? "/#como-funciona" : "#como-funciona" },
  { name: "Preguntas", href: isSubpage ? "/#faq" : "#faq" },
  { name: "Contacto", href: isSubpage ? "/#contacto" : "#contacto" },
];

const whatsappUrl = "https://wa.me/525610683465?text=Hola,%20quiero%20cotizar%20una%20invitaci%C3%B3n%20digital";
---

<footer class="relative bg-night-950 border-t border-night-800 text-muted-silver pt-16 pb-12 overflow-hidden">
  
  <!-- Subtle ambient glow at bottom -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-32 bg-gradient-to-t from-gold-500/10 to-transparent blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 pb-12 border-b border-night-800/80">
      
      <!-- Brand & Tagline Column (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5 focus:outline-none">
          <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-night-800 to-night-700 border border-gold-500/30 flex items-center justify-center shadow-[0_0_12px_rgba(201,168,118,0.2)]">
            <svg class="w-5 h-5 text-gold-400" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" fill="currentColor" fill-opacity="0.15"/>
              <path d="M18 5L18.5 6.5L20 7L18.5 7.5L18 9L17.5 7.5L16 7L17.5 6.5L18 5Z" fill="currentColor"/>
            </svg>
          </div>
          <span class="font-serif text-2xl font-bold tracking-tight text-warm-white">
            Luna<span class="text-gold-500 font-sans font-medium text-lg">web</span>
          </span>
        </a>

        <p class="text-sm text-muted-silver/90 max-w-sm font-light leading-relaxed">
          Diseñamos invitaciones digitales interactivas de alta gama para bodas, XV años, bautizos y aniversarios. Tu gran momento merece un inicio inolvidable.
        </p>

        <!-- Social Media Icons (Vector only, no emojis) -->
        <div class="flex items-center gap-3 pt-2">
          <!-- WhatsApp Icon Link -->
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-night-900 border border-night-700 hover:border-gold-500/50 hover:bg-gold-500/10 text-muted-silver hover:text-gold-400 flex items-center justify-center transition-all"
            aria-label="Contactar a Lunaweb por WhatsApp"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.072.044.419-.1 1.024z"/>
              <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.527 3.66 1.443 5.176L2 22l4.981-1.306C8.423 21.535 10.154 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.25c-1.637 0-3.15-.466-4.437-1.272l-.318-.2-2.964.777.791-2.89-.208-.331C3.993 14.996 3.5 13.546 3.5 12c0-4.687 3.813-8.5 8.5-8.5 4.687 0 8.5 3.813 8.5 8.5 0 4.688-3.813 8.5-8.5 8.5z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-night-900 border border-night-700 hover:border-gold-500/50 hover:bg-gold-500/10 text-muted-silver hover:text-gold-400 flex items-center justify-center transition-all"
            aria-label="Instagram de Lunaweb"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <!-- TikTok -->
          <a
            href="https://tiktok.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-night-900 border border-night-700 hover:border-gold-500/50 hover:bg-gold-500/10 text-muted-silver hover:text-gold-400 flex items-center justify-center transition-all"
            aria-label="TikTok de Lunaweb"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.27 6.27 0 0 0 1.86-4.49v-7a8.16 8.16 0 0 0 4.91 1.64V6.83a4.85 4.85 0 0 1-1-.14z"/>
            </svg>
          </a>

          <!-- Email -->
          <a
            href="mailto:lued18961@gmail.com"
            class="w-9 h-9 rounded-full bg-night-900 border border-night-700 hover:border-gold-500/50 hover:bg-gold-500/10 text-muted-silver hover:text-gold-400 flex items-center justify-center transition-all"
            aria-label="Enviar correo electrónico a Lunaweb"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Navigation Column -->
      <div class="space-y-3">
        <span class="block text-xs uppercase tracking-wider font-semibold text-warm-white">
          Navegación
        </span>
        <ul class="space-y-2 text-sm">
          {navLinks.map((item) => (
            <li>
              <a href={item.href} class="hover:text-gold-300 transition-colors">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Eventos Populares Column -->
      <div class="space-y-3">
        <span class="block text-xs uppercase tracking-wider font-semibold text-warm-white">
          Eventos
        </span>
        <ul class="space-y-2 text-sm">
          <li><a href="/catalogo" class="hover:text-gold-300 transition-colors">Invitaciones de XV Años</a></li>
          <li><a href="/catalogo" class="hover:text-gold-300 transition-colors">Invitaciones de Boda</a></li>
          <li><a href="/catalogo" class="hover:text-gold-300 transition-colors">Invitaciones de Bautizo</a></li>
          <li><a href="/catalogo" class="hover:text-gold-300 transition-colors">Cumpleaños y Aniversarios</a></li>
          <li><a href="/catalogo" class="hover:text-gold-300 transition-colors">Baby Showers & Primera Comunión</a></li>
        </ul>
      </div>

      <!-- Legal & Contact Column -->
      <div class="space-y-3">
        <span class="block text-xs uppercase tracking-wider font-semibold text-warm-white">
          Contacto & Legal
        </span>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://wa.me/525610683465" target="_blank" rel="noopener noreferrer" class="hover:text-gold-300 transition-colors flex items-center gap-1.5">
              <span>WhatsApp: +52 56 1068 3465</span>
            </a>
          </li>
          <li>
            <a href="mailto:lued18961@gmail.com" class="hover:text-gold-300 transition-colors">
              lued18961@gmail.com
            </a>
          </li>
          <li class="pt-2">
            <a href="/terminos" class="text-xs text-muted-silver/80 hover:text-gold-400 underline decoration-night-700 hover:decoration-gold-400 transition-colors block">
              Términos y Condiciones
            </a>
          </li>
          <li>
            <a href="/privacidad" class="text-xs text-muted-silver/80 hover:text-gold-400 underline decoration-night-700 hover:decoration-gold-400 transition-colors block">
              Aviso de Privacidad (LFPDPPP)
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Details -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-silver/70">
      <p>
        © {currentYear} <strong class="text-warm-white font-medium">Lunaweb</strong>. Todos los derechos reservados.
      </p>

      <p class="text-center sm:text-right">
        Diseñado para momentos únicos. Elegancia digital bajo la luz de la luna.
      </p>
    </div>

  </div>
</footer>
