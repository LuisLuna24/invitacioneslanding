---
interface Props {
  isSubpage?: boolean;
}

const { isSubpage = false } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isCatalog = pathname.startsWith("/catalogo");

const navItems = [
  { id: "inicio", name: "Inicio", href: isHome ? "#inicio" : "/#inicio", isPage: false },
  { id: "catalogo", name: "Catálogo", href: "/catalogo", isPage: true },
  { id: "beneficios", name: "Beneficios", href: isHome ? "#beneficios" : "/#beneficios", isPage: false },
  { id: "como-funciona", name: "Cómo funciona", href: isHome ? "#como-funciona" : "/#como-funciona", isPage: false },
  { id: "contacto", name: "Contacto", href: isHome ? "#contacto" : "/#contacto", isPage: false },
];

const whatsappUrl = "https://wa.me/525610683465?text=Hola,%20quiero%20cotizar%20una%20invitaci%C3%B3n%20digital";
---

<header
  x-data={`{
    isScrolled: false,
    mobileOpen: false,
    activeItem: '${isCatalog ? "catalogo" : (isHome ? "inicio" : "")}',
    isHomePage: ${isHome},
    isCatalogPage: ${isCatalog},

    init() {
      // Set initial scroll state
      this.isScrolled = window.scrollY > 25;

      if (this.isCatalogPage) {
        this.activeItem = 'catalogo';
      } else if (this.isHomePage) {
        this.setupScrollSpy();
      }
    },

    setupScrollSpy() {
      const sectionIds = ['inicio', 'beneficios', 'portafolio', 'como-funciona', 'contacto'];
      
      const onScroll = () => {
        this.isScrolled = window.scrollY > 25;
        const scrollPosition = window.scrollY + 200;

        // If at the very top
        if (window.scrollY < 120) {
          this.activeItem = 'inicio';
          return;
        }

        for (let i = sectionIds.length - 1; i >= 0; i--) {
          const sectionEl = document.getElementById(sectionIds[i]);
          if (sectionEl && sectionEl.offsetTop <= scrollPosition) {
            this.activeItem = sectionIds[i];
            return;
          }
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }`}
  @keydown.escape.window="mobileOpen = false"
  :class="{
    'bg-night-950/90 backdrop-blur-md border-b border-night-700/60 shadow-lg shadow-black/40 py-3': isScrolled,
    'bg-transparent border-b border-white/5 py-5': !isScrolled
  }"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-in-out"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href="/" class="group flex items-center gap-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 rounded-lg p-1">
        <div class="relative w-9 h-9 rounded-full bg-gradient-to-tr from-night-800 to-night-700 border border-gold-500/30 flex items-center justify-center transition-transform duration-300 group-hover:scale-105 group-hover:border-gold-400 shadow-[0_0_15px_rgba(201,168,118,0.2)]">
          <!-- Luna + Star SVG -->
          <svg class="w-5 h-5 text-gold-400 transition-colors group-hover:text-gold-300" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" fill="currentColor" fill-opacity="0.15"/>
            <path d="M18 5L18.5 6.5L20 7L18.5 7.5L18 9L17.5 7.5L16 7L17.5 6.5L18 5Z" fill="currentColor"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-2xl font-bold tracking-tight text-warm-white group-hover:text-gold-300 transition-colors">
            Luna<span class="text-gold-500 font-sans font-medium text-lg tracking-normal">web</span>
          </span>
          <span class="text-[10px] uppercase tracking-widest text-muted-silver/80 -mt-1 font-sans">Invitaciones Digitales</span>
        </div>
      </a>

      <!-- Desktop Navigation Menu with Active State Indicators -->
      <nav class="hidden md:flex items-center gap-1 bg-night-900/70 border border-night-700/50 rounded-full p-1.5 backdrop-blur-md" aria-label="Navegación principal">
        {navItems.map((item) => (
          <a
            href={item.href}
            :class={`activeItem === '${item.id}'
              ? 'text-gold-300 font-semibold bg-night-800 border border-gold-500/35 shadow-[0_0_15px_rgba(201,168,118,0.2)]'
              : 'text-muted-silver hover:text-warm-white hover:bg-night-800/40 border border-transparent'`}
            class="relative text-xs lg:text-sm px-3.5 py-1.5 rounded-full transition-all duration-200 flex items-center gap-1.5 cursor-pointer"
          >
            <!-- Active Golden Beacon Dot -->
            <span
              x-show={`activeItem === '${item.id}'`}
              x-cloak
              class="w-1.5 h-1.5 rounded-full bg-gold-400 shadow-[0_0_8px_#C9A876]"
            ></span>
            <span>{item.name}</span>
          </a>
        ))}
      </nav>

      <!-- Desktop CTA Button -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="relative inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-night-950 bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 hover:from-gold-300 hover:to-gold-400 shadow-[0_0_20px_rgba(201,168,118,0.3)] hover:shadow-[0_0_25px_rgba(201,168,118,0.5)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gold-400 focus-visible:ring-offset-night-950"
        >
          <!-- WhatsApp Icon -->
          <svg class="w-4 h-4 text-night-950" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.072.044.419-.1 1.024z"/>
            <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.527 3.66 1.443 5.176L2 22l4.981-1.306C8.423 21.535 10.154 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.25c-1.637 0-3.15-.466-4.437-1.272l-.318-.2-2.964.777.791-2.89-.208-.331C3.993 14.996 3.5 13.546 3.5 12c0-4.687 3.813-8.5 8.5-8.5 4.687 0 8.5 3.813 8.5 8.5 0 4.688-3.813 8.5-8.5 8.5z"/>
          </svg>
          <span>Cotiza tu invitación</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex items-center gap-3 md:hidden">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-full bg-gold-500/10 text-gold-400 border border-gold-500/30 hover:bg-gold-500/20 transition-colors"
          aria-label="Contactar por WhatsApp"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.072.044.419-.1 1.024z"/>
            <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.527 3.66 1.443 5.176L2 22l4.981-1.306C8.423 21.535 10.154 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.25c-1.637 0-3.15-.466-4.437-1.272l-.318-.2-2.964.777.791-2.89-.208-.331C3.993 14.996 3.5 13.546 3.5 12c0-4.687 3.813-8.5 8.5-8.5 4.687 0 8.5 3.813 8.5 8.5 0 4.688-3.813 8.5-8.5 8.5z"/>
          </svg>
        </a>

        <button
          type="button"
          @click="mobileOpen = !mobileOpen"
          class="p-2 rounded-lg bg-night-800 text-warm-white border border-night-700/80 hover:bg-night-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500"
          :aria-expanded="mobileOpen.toString()"
          aria-label="Abrir menú de navegación"
        >
          <svg x-show="!mobileOpen" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <svg x-show="mobileOpen" x-cloak class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu with Active Item Highlighting -->
  <div
    x-show="mobileOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
    class="md:hidden bg-night-950/95 backdrop-blur-xl border-b border-night-700/80 px-4 pt-4 pb-6 space-y-3 mt-2"
  >
    <div class="flex flex-col space-y-1.5">
      {navItems.map((item) => (
        <a
          href={item.href}
          @click="mobileOpen = false"
          :class={`activeItem === '${item.id}'
            ? 'text-gold-300 font-semibold bg-night-800/90 border-l-2 border-gold-400 pl-3.5'
            : 'text-warm-white hover:text-gold-300 hover:bg-night-800/50 pl-3'`}
          class="px-4 py-2.5 text-base rounded-lg transition-colors flex items-center justify-between"
        >
          <span>{item.name}</span>
          <span
            x-show={`activeItem === '${item.id}'`}
            x-cloak
            class="text-[10px] uppercase tracking-wider text-gold-400 font-semibold bg-gold-500/10 px-2 py-0.5 rounded-full border border-gold-500/20"
          >
            Aquí estás
          </span>
        </a>
      ))}
    </div>

    <div class="pt-3 border-t border-night-800">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        @click="mobileOpen = false"
        class="w-full flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-base font-semibold text-night-950 bg-gradient-to-r from-gold-400 to-gold-500 hover:from-gold-300 hover:to-gold-400 shadow-[0_0_20px_rgba(201,168,118,0.3)] transition-all"
      >
        <svg class="w-5 h-5 text-night-950" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.072.044.419-.1 1.024z"/>
          <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.527 3.66 1.443 5.176L2 22l4.981-1.306C8.423 21.535 10.154 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.25c-1.637 0-3.15-.466-4.437-1.272l-.318-.2-2.964.777.791-2.89-.208-.331C3.993 14.996 3.5 13.546 3.5 12c0-4.687 3.813-8.5 8.5-8.5 4.687 0 8.5 3.813 8.5 8.5 0 4.688-3.813 8.5-8.5 8.5z"/>
        </svg>
        <span>Cotizar por WhatsApp</span>
      </a>
    </div>
  </div>
</header>
